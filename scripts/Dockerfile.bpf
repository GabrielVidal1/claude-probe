# The toolchain that compiles internal/probe/bpf/probe.bpf.c — used only by
# `make generate` (the generated .o files are committed: `go build` needs
# nothing but Go). vmlinux.h comes from the build machine's BTF.
FROM golang:1.27-trixie@sha256:c65ecfe613b539ac74c62a4c3b2c27e8f8a6076384c8f27e8a3c0f3be17cc385
RUN apt-get update \
 && apt-get install -y --no-install-recommends clang llvm libbpf-dev bpftool \
 && rm -rf /var/lib/apt/lists/*
